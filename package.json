{
  "name": "@monsters/validator",
  "version": "0.1.0",
  "description": "Validator standalone package for monsters service",
  "productName": "@monsters/validator",
  "author": "https://github.com/Virus288",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    "import": "./lib/index.js",
    "require": "./lib/commonIndex.cjs"
  },
  "files": [
    "/lib",
    "/types"
  ],
  "keywords": [],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:common": "rollup --config",
    "build:watch": "tsc -w -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs . --fix",
    "listErrors": "node_modules/.bin/tsc --skipLibCheck -p tsconfig.json",
    "lintStaged": "npx lint-staged",
    "test": "echo 'If you want to run all the tests, please use makefile'",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config  __tests__/jest.config.e2e.ts",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config __tests__/jest.config.unit.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/compat": "^1.2.2",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@jest/globals": "^30.0.0-beta.3",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "cross-env": "7.0.3",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-check-file": "3.2.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "28.13.0",
    "eslint-plugin-jsdoc": "^50.0.0",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-sort-class-members": "1.21.0",
    "jest": "^29.7.0",
    "prettier": "3.5.3",
    "rollup": "^4.22.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=16"
  },
  "lint-staged": {
    "*.ts": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ]
  }
}
